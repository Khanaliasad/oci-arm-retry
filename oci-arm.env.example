# Copy to oci-arm.env and fill in. Plain KEY=value, no spaces around "=".
# No secrets here: OCIDs are identifiers, and your API key stays in ~/.oci/

# Your tenancy OCID (the `tenancy=` line in ~/.oci/config) for the root compartment.
COMPARTMENT_ID="ocid1.tenancy.oc1..REPLACE_ME"
REGION="ap-mumbai-1"
# List with: oci iam availability-domain list --compartment-id <tenancy ocid> --query 'data[].name'
AVAILABILITY_DOMAIN="REPLACE_ME:AP-MUMBAI-1-AD-1"

# Public subnet OCID, and an aarch64 Ubuntu image OCID (see README, "Find your IDs").
SUBNET_ID="ocid1.subnet.oc1.REGION.REPLACE_ME"
IMAGE_ID="ocid1.image.oc1.REGION.REPLACE_ME"
# Public key made with: ssh-keygen -t ed25519 -f ~/.ssh/oci_a1
SSH_PUBLIC_KEY_FILE="$HOME/.ssh/oci_a1.pub"

DISPLAY_NAME="arm-ubuntu-1"

# Always Free Arm limit per Oracle's docs (checked Oct 2026): 2 OCPU / 12 GB total,
# 200 GB for boot + block volumes combined. The script refuses to run above these.
OCPUS=2
MEMORY_GB=12
BOOT_GB=200

# Seconds between attempts, and the pause after a "too many requests" reply.
RETRY_SECONDS=120
COOLDOWN_SECONDS=600
